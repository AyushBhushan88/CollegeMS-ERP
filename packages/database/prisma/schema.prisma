generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  HOD
  FACULTY
  STUDENT
  PARENT
  FINANCE_STAFF
  HR_STAFF
  LIBRARIAN
  HOSTEL_WARDEN
  PLACEMENT_OFFER
  EXAM_CONTROLLER
}

enum StudentStatus {
  APPLIED
  ADMITTED
  ENROLLED
  SEMESTER_BREAK
  GRADUATED
  DROPOUT
  SUSPENDED
  EXPELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  OBC
  SC
  ST
  EWS
  PWD
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum TransactionStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             UserRole
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  twoFactorSecret  String?
  isTwoFactorEnabled Boolean @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student?
  applications     AdmissionApplication[]
  documents        Document[]
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  permissions Json     // Array of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Program {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  branches    Branch[]
  students    Student[]
  applications AdmissionApplication[]
  feeStructures FeeStructure[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  name        String
  code        String   @unique
  description String?
  students    Student[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Student {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id])
  enrollmentNumber  String        @unique
  rollNumber        String?
  programId         String
  program           Program       @relation(fields: [programId], references: [id])
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  batchYear         Int
  currentSemester   Int
  admissionDate     DateTime
  category          Category
  dateOfBirth       DateTime
  gender            Gender
  bloodGroup        String?
  aadhaarNumber     String?
  permanentAddress  Json
  correspondenceAddress Json
  guardianName      String
  guardianPhone     String
  guardianEmail     String?
  guardianRelation  String
  status            StudentStatus @default(ENROLLED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions      Transaction[]
}

model AdmissionApplication {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  programId       String
  program         Program           @relation(fields: [programId], references: [id])
  status          ApplicationStatus @default(PENDING)
  personalDetails Json
  academicDetails Json
  choiceOfProgram Json
  paymentStatus   TransactionStatus @default(INITIATED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String   // e.g., "10th_Marksheet", "Photo"
  url       String
  status    String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeStructure {
  id             String   @id @default(uuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id])
  batchYear      Int
  category       Category
  academicYear   String
  semester       Int
  feeHeads       Json     // Array of {headName, amount, isMandatory}
  totalAmount    Decimal  @db.Decimal(12, 2)
  dueDate        DateTime
  lateFeePerDay  Decimal  @default(0) @db.Decimal(8, 2)
  installments   Json?    // Array of {installmentNo, amount, dueDate}
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   Transaction[]

  @@unique([programId, batchYear, category, academicYear, semester])
}

model Transaction {
  id                String            @id @default(uuid())
  studentId         String?
  student           Student?          @relation(fields: [studentId], references: [id])
  feeStructureId    String?
  feeStructure      FeeStructure?     @relation(fields: [feeStructureId], references: [id])
  transactionId     String            @unique
  gatewayReference  String?
  amount            Decimal           @db.Decimal(12, 2)
  paymentMethod     String
  status            TransactionStatus @default(INITIATED)
  receiptNumber     String?           @unique
  receiptUrl        String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
