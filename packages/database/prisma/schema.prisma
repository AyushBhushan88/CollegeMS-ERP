generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  HOD
  FACULTY
  STUDENT
  PARENT
  FINANCE_STAFF
  HR_STAFF
  LIBRARIAN
  HOSTEL_WARDEN
  PLACEMENT_OFFICER
  EXAM_CONTROLLER
}

enum StudentStatus {
  APPLIED
  ADMITTED
  ENROLLED
  SEMESTER_BREAK
  GRADUATED
  DROPOUT
  SUSPENDED
  EXPELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  OBC
  SC
  ST
  EWS
  PWD
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum TransactionStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  INTERNAL
  MIDTERM
  END_SEMESTER
  LAB
  VIVA
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BookStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum PlacementStatus {
  PENDING
  OFFERED
  REJECTED
}

enum GrievanceStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  CLOSED
  REOPENED
  ESCALATED
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AlumniStatus {
  UNVERIFIED
  VERIFIED
  ACTIVE
  INACTIVE
}

enum MentorshipStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             UserRole
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  twoFactorSecret  String?
  isTwoFactorEnabled Boolean @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student?
  employeeProfile  EmployeeProfile?
  applications     AdmissionApplication[]
  documents        Document[]
  timetableSlots    TimetableSlot[] @relation("FacultySlots")
  markedAttendance AttendanceRecord[] @relation("MarkedBy")
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  permissions Json     // Array of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Program {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  branches    Branch[]
  students    Student[]
  applications AdmissionApplication[]
  feeStructures FeeStructure[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  name        String
  code        String   @unique
  description String?
  students    Student[]
  subjects    Subject[]
  sections    Section[]
  exams       Exam[]
  programOutcomes ProgramOutcome[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Student {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id])
  enrollmentNumber  String        @unique
  rollNumber        String?
  programId         String
  program           Program       @relation(fields: [programId], references: [id])
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  batchYear         Int
  currentSemester   Int
  admissionDate     DateTime
  category          Category
  dateOfBirth       DateTime
  gender            Gender
  bloodGroup        String?
  aadhaarNumber     String?
  permanentAddress  Json
  correspondenceAddress Json
  guardianName      String
  guardianPhone     String
  guardianEmail     String?
  guardianRelation  String
  status            StudentStatus @default(ENROLLED)
  sectionId         String?
  section           Section?          @relation(fields: [sectionId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions          Transaction[]
  attendance            AttendanceRecord[]
  marks                 MarksEntry[]
  transcripts           Transcript[]
  libraryIssues         IssueRecord[]
  roomAllocation        RoomAllocation?
  transportAllocation   TransportAllocation?
  placementApplications PlacementApplication[]
  alumniProfile         AlumniProfile?
}

model AdmissionApplication {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  programId       String
  program         Program           @relation(fields: [programId], references: [id])
  status          ApplicationStatus @default(PENDING)
  personalDetails Json
  academicDetails Json
  choiceOfProgram Json
  paymentStatus   TransactionStatus @default(INITIATED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String   // e.g., "10th_Marksheet", "Photo"
  url       String
  status    String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeStructure {
  id             String   @id @default(uuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id])
  batchYear      Int
  category       Category
  academicYear   String
  semester       Int
  feeHeads       Json     // Array of {headName, amount, isMandatory}
  totalAmount    Decimal  @db.Decimal(12, 2)
  dueDate        DateTime
  lateFeePerDay  Decimal  @default(0) @db.Decimal(8, 2)
  installments   Json?    // Array of {installmentNo, amount, dueDate}
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   Transaction[]

  @@unique([programId, batchYear, category, academicYear, semester])
}

model Transaction {
  id                String            @id @default(uuid())
  studentId         String?
  student           Student?          @relation(fields: [studentId], references: [id])
  feeStructureId    String?
  feeStructure      FeeStructure?     @relation(fields: [feeStructureId], references: [id])
  transactionId     String            @unique
  gatewayReference  String?
  amount            Decimal           @db.Decimal(12, 2)
  paymentMethod     String
  status            TransactionStatus @default(INITIATED)
  receiptNumber     String?           @unique
  receiptUrl        String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Subject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  credits     Int
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  semester    Int
  type        String   @default("CORE") // CORE, ELECTIVE, LAB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots         TimetableSlot[]
  marks         MarksEntry[]
  attendance    AttendanceRecord[]
  examSchedules ExamSchedule[]
  courseOutcomes CourseOutcome[]
}

model Section {
  id          String   @id @default(uuid())
  name        String   // e.g., "A", "B", "C"
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  batchYear   Int
  semester    Int
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]
  slots       TimetableSlot[]
  attendance  AttendanceRecord[]
  @@unique([branchId, batchYear, semester, name])
}

model TimetableSlot {
  id          String    @id @default(uuid())
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  facultyId   String    // References User.id where role=FACULTY
  faculty     User      @relation("FacultySlots", fields: [facultyId], references: [id])
  dayOfWeek   DayOfWeek
  startTime   String    // HH:mm format
  endTime     String    // HH:mm format
  roomNumber  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sectionId, dayOfWeek, startTime])
  @@unique([facultyId, dayOfWeek, startTime])
  @@unique([roomNumber, dayOfWeek, startTime])
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id])
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id])
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  markedById  String           // Faculty ID
  markedBy    User             @relation("MarkedBy", fields: [markedById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, subjectId, date])
}

model Exam {
  id            String         @id @default(uuid())
  name          String         // e.g., "End Sem Nov 2024"
  type          ExamType
  academicYear  String
  semester      Int
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  startDate     DateTime
  endDate       DateTime
  totalMarks    Int
  weightage     Int            // % weightage for final result
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  schedules     ExamSchedule[]
  marks         MarksEntry[]
}

model ExamSchedule {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  date          DateTime
  startTime     String
  endTime       String
  roomNumber    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, subjectId])
}

model MarksEntry {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  marksObtained Float
  isAbsent      Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, subjectId, studentId])
}

model Transcript {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  semester        Int
  sgpa            Float
  cgpa            Float
  totalCredits    Int
  earnedCredits   Int
  resultStatus    String   // PASS, FAIL, WITHHELD
  isFinalized     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, semester])
}

model ProgramOutcome {
  id          String   @id @default(uuid())
  code        String
  description String
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectCOPOs SubjectCOPO[]
  @@unique([branchId, code])
}

model CourseOutcome {
  id          String   @id @default(uuid())
  code        String
  description String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectCOPOs SubjectCOPO[]
  @@unique([subjectId, code])
}

model SubjectCOPO {
  id               String         @id @default(uuid())
  courseOutcomeId  String
  courseOutcome    CourseOutcome  @relation(fields: [courseOutcomeId], references: [id])
  programOutcomeId String
  programOutcome   ProgramOutcome @relation(fields: [programOutcomeId], references: [id])
  mappingStrength  Int            // 1, 2, or 3
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([courseOutcomeId, programOutcomeId])
}

enum HostelType {
  BOYS
  GIRLS
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
}

model EmployeeProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  employeeCode     String         @unique
  designation      String
  department       String
  joiningDate      DateTime
  salary           Decimal?       @db.Decimal(12, 2)
  status           EmployeeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  libraryIssues    IssueRecord[]
  approvedLeaves   LeaveRequest[] @relation("ApprovedBy")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  approvedBy    EmployeeProfile? @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LeaveBalance {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType
  total         Int
  used          Int             @default(0)
  year          Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([employeeId, leaveType, year])
}

model Book {
  id          String    @id @default(uuid())
  title       String
  isbn        String    @unique
  author      String
  publisher   String
  subject     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  copies      BookCopy[]
}

model BookCopy {
  id              String     @id @default(uuid())
  bookId          String
  book            Book       @relation(fields: [bookId], references: [id])
  accessionNumber String     @unique
  status          BookStatus @default(AVAILABLE)
  location        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  issues          IssueRecord[]
}

model IssueRecord {
  id            String    @id @default(uuid())
  bookCopyId    String
  bookCopy      BookCopy  @relation(fields: [bookCopyId], references: [id])
  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id])
  employeeId    String?
  employee      EmployeeProfile? @relation(fields: [employeeId], references: [id])
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  fineAmount    Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Hostel {
  id        String     @id @default(uuid())
  name      String     @unique
  type      HostelType
  capacity  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  rooms     Room[]
}

model Room {
  id          String     @id @default(uuid())
  hostelId    String
  hostel      Hostel     @relation(fields: [hostelId], references: [id])
  roomNumber  String
  floor       Int
  type        RoomType
  capacity    Int
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  allocations RoomAllocation[]

  @@unique([hostelId, roomNumber])
}

model RoomAllocation {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique
  capacity           Int
  driverName         String?
  driverPhone        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  allocations        TransportAllocation[]
}

model Route {
  id          String   @id @default(uuid())
  name        String   @unique
  source      String
  destination String
  stops       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations TransportAllocation[]
}

model TransportAllocation {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  pickupPoint String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlacementDrive {
  id                  String   @id @default(uuid())
  companyName         String
  date                DateTime
  eligibilityCriteria Json
  packageDetails      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applications        PlacementApplication[]
}

model PlacementApplication {
  id          String          @id @default(uuid())
  driveId     String
  drive       PlacementDrive  @relation(fields: [driveId], references: [id])
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id])
  status      PlacementStatus @default(PENDING)
  resumeUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  result      PlacementResult?

  @@unique([driveId, studentId])
}

model PlacementResult {
  id              String               @id @default(uuid())
  applicationId   String               @unique
  application     PlacementApplication @relation(fields: [applicationId], references: [id])
  offerLetterUrl  String?
  packageOffered  Decimal?             @db.Decimal(12, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model GrievanceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  committees  GrievanceCommittee[]
  grievances  Grievance[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GrievanceCommittee {
  id          String   @id @default(uuid())
  name        String   @unique
  members     Json     // Array of User IDs
  categories  GrievanceCategory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Grievance {
  id            String           @id @default(uuid())
  ticketNumber  String           @unique
  complainantId String           // User ID
  categoryId    String
  category      GrievanceCategory @relation(fields: [categoryId], references: [id])
  subject       String
  description   String
  priority      GrievancePriority @default(MEDIUM)
  status        GrievanceStatus   @default(PENDING)
  attachments   Json?            // Array of URLs
  isAnonymous   Boolean           @default(false)
  assignedToId  String?          // Committee ID
  resolvedById  String?          // User ID
  resolution    String?
  resolvedAt    DateTime?
  slaDeadline   DateTime
  comments      GrievanceComment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model GrievanceComment {
  id          String    @id @default(uuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
  userId      String
  comment     String
  attachments Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AlumniProfile {
  id              String       @id @default(uuid())
  studentId       String       @unique
  student         Student      @relation(fields: [studentId], references: [id])
  graduationYear  Int
  currentCompany  String?
  designation     String?
  industry        String?
  location        String?
  linkedInUrl     String?
  status          AlumniStatus @default(UNVERIFIED)
  mentorshipApps  MentorshipApplication[]
  donations       Donation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model AlumniEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String   // e.g., "REUNION", "WEBINAR"
  capacity    Int
  registrations Json   // Array of User IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MentorshipProgram {
  id          String   @id @default(uuid())
  title       String
  description String
  mentorId    String   // User ID (Alumni)
  startDate   DateTime
  endDate     DateTime
  capacity    Int
  applications MentorshipApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MentorshipApplication {
  id          String            @id @default(uuid())
  programId   String
  program     MentorshipProgram @relation(fields: [programId], references: [id])
  alumniId    String
  alumni      AlumniProfile     @relation(fields: [alumniId], references: [id])
  status      MentorshipStatus  @default(PENDING)
  statement   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Donation {
  id              String        @id @default(uuid())
  alumniId        String
  alumni          AlumniProfile @relation(fields: [alumniId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  purpose         String?
  transactionId   String        @unique
  paymentMethod   String
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
